# ---------------------------------------------------------------------------
# Lexa — environment. Created by Emma Cehic.
# Copy to .env.local and fill in. Never commit or share .env.local.
#
# Minimal self-hosted setup (see README.md): DATABASE_URL, AUTH_SECRET,
# AUTH_URL, REDIS_URL, STORAGE_BACKEND=local, LOCAL_MEDIA_PATH,
# WHISPER_SERVER_URL, WHISPER_MODEL, WHISPER_API_KEY, SEED_ADMIN_PASSWORD.
# ---------------------------------------------------------------------------

# Postgres. With the Docker setup from README.md:
#   postgresql://lexa:YOUR_DB_PASSWORD@localhost:5433/lexa
# Neon or Supabase Postgres also work. The worker uses the same URL.
DATABASE_URL=

# Auth.js. Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Must be the exact origin people open. Use the https:// tunnel URL when sharing.
AUTH_URL=http://localhost:3000

# Redis for the BullMQ transcription queue.
# Docker: redis://localhost:6379   Upstash: rediss://... (TLS)
REDIS_URL=redis://localhost:6379

# Media storage: local | supabase | hybrid
#   local   — every recording on this machine's disk (LOCAL_MEDIA_PATH)
#   hybrid  — files up to HYBRID_SUPABASE_MAX_BYTES on Supabase, larger on disk
#   supabase — everything on Supabase Storage (private bucket, signed URLs only)
STORAGE_BACKEND=local
# Files at or below this size (bytes) upload to Supabase in hybrid mode. Default 100 MB.
HYBRID_SUPABASE_MAX_BYTES=104857600
# Folder on this machine for recordings when STORAGE_BACKEND=local or hybrid.
# Use an absolute path, e.g. D:\lexa-recordings or /var/lexa/recordings
LOCAL_MEDIA_PATH=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=recordings

# Local Whisper speech-to-text (used when Google Cloud below is not configured).
# scripts/start-whisper.ps1 starts hwdsl2/whisper-server:cuda on the GPU and
# falls back to CPU. The server generates a Bearer token; read it with:
#   docker exec lexa-whisper whisper_manage --getkey
WHISPER_SERVER_URL=http://localhost:9000
# base is fast; large-v3 is the most accurate (needs a GPU for long recordings).
WHISPER_MODEL=base
WHISPER_API_KEY=

# Optional: Google Cloud Speech-to-Text v2 (model chirp_2) + a GCS staging
# bucket. When all three of GCP_PROJECT_ID, GCP_SERVICE_ACCOUNT_JSON and
# GCS_STAGING_BUCKET are set, Google is used instead of Whisper.
GCP_PROJECT_ID=
GCP_LOCATION=europe-west4
# The service-account JSON, on one line. Roles required:
#   roles/speech.client  and  roles/storage.objectAdmin
GCP_SERVICE_ACCOUNT_JSON=
GCS_STAGING_BUCKET=

# Optional, currently unused: the orthography pass is switched off and the
# transcript is kept exactly as Whisper returns it. If it is re-enabled,
# Gemini is used when GEMINI_API_KEY is set, otherwise Ollama.
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# Optional: SMTP for magic-link sign-in, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
# From-address for magic-link mail (optional, defaults to lexa@<smtp host>)
SMTP_FROM=

# Admin account created by `pnpm seed`. Change the password after first login.
SEED_ADMIN_EMAIL=admin@lexa.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
