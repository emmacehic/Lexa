{
  "name": "lexa",
  "version": "1.0.0",
  "description": "Lexa — transcription, loanword and code-switching annotation for linguistic fieldwork.",
  "author": "Emma Cehic",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/sync-flag-assets.ts && prisma generate && next build",
    "sync-flags": "tsx scripts/sync-flag-assets.ts",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate && tsx scripts/sync-flag-assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.7.0",
    "@google-cloud/storage": "^7.14.0",
    "@google/genai": "^0.14.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-virtual": "^3.11.2",
    "bullmq": "^5.34.6",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "flag-icons": "^7.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.2",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tus-js-client": "^4.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
